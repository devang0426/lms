# Studyhall — environment variables
# Copy to .env.local for local dev. Never commit real values.
# Variables marked [trigger] must ALSO be set in the Trigger.dev dashboard
# (Project → Environment Variables), because tasks run on Trigger.dev's machines.
#
# The app checks these when it starts (lib/env.ts, feature 24). If a
# [required] one is missing or malformed, it refuses to start and names
# every problem at once. [optional] ones have defaults in code.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# [required] This deployment's own URL. Invitation links are built from it.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [optional] Shows the one-click demo account picker on the sign-in page.
# Anyone who can open the sign-in page can then be the admin, so while it's
# "true", role changes, invitations and roster import are turned off.
# Never "true" in a real rollout.
DEMO_MODE=false
# [required when DEMO_MODE=true] Password set on both demo accounts by
# `npm run db:seed` (demo admin + demo student).
DEMO_ACCOUNT_PASSWORD=change-me-demo-2026
# [required when DEMO_MODE=true on a production deployment (VERCEL_ENV=production)]
# The picker asks for it before signing anyone in. At least 8 characters.
# Optional locally: set it to try the passcode step.
# DEMO_PASSCODE=
# [optional; scripts only] Database hosts `npm run demo:reset` may wipe,
# comma-separated. It refuses to run against any other host. A Neon host
# covers its "-pooler" twin, e.g. ep-cool-darkness-123456.us-east-2.aws.neon.tech
DEMO_DB_HOSTS=

# ---------------------------------------------------------------------------
# The institute (feature 34): shown on the public landing page (/welcome),
# its share image, and the privacy and terms pages. Those pages are static,
# so they're built with these values: after a change, rebuild (on Vercel,
# redeploy). `next build` stops if INSTITUTE_NAME is missing.
# ---------------------------------------------------------------------------
# [required] The institute's name, at most 80 characters.
INSTITUTE_NAME=Northfield University
# [optional] One line under the headline, at most 160 characters.
INSTITUTE_TAGLINE=Lectures, notes and study tools for every course, in one calm place.
# [one of these two is required] How visitors without an invitation reach
# the office. Both show in the footer when set.
INSTITUTE_EMAIL=office@northfield.example.edu
# INSTITUTE_PHONE=+91 22 1234 5678
# [optional] A postal address for the footer, one line.
# INSTITUTE_ADDRESS=1 College Road, Pune 411001

# ---------------------------------------------------------------------------
# Neon Postgres (+ pgvector)                                         [trigger]
# neon.tech → Project → Connection Details
# ---------------------------------------------------------------------------
# [required] Direct connection (no "-pooler" in the host): used by drizzle-kit migrations.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/studyhall?sslmode=require
# [optional, recommended] Pooled connection (host contains "-pooler"): used by
# the app and tasks when set, instead of DATABASE_URL.
DATABASE_URL_POOLED=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/studyhall?sslmode=require
# [optional; measuring only] "1" logs every Neon request (one query or one
# db.batch) with its time, grouped per page render, to count round trips
# (feature 29). It reads request bodies: leave it unset on deployments.
# DB_LOG=1

# ---------------------------------------------------------------------------
# Clerk (auth)
# dashboard.clerk.com → API Keys
# ---------------------------------------------------------------------------
# [required]
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# [required]
CLERK_SECRET_KEY=sk_test_replace-with-your-clerk-secret-key
# [required] dashboard.clerk.com → Webhooks → endpoint for /api/webhooks/clerk (user.created, user.updated, user.deleted)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Sign-in/up URLs and redirects are set in code (proxy.ts, app/layout.tsx); no env needed.

# ---------------------------------------------------------------------------
# Vercel Blob (videos, documents, captions, podcasts, submissions)   [trigger]
# Vercel → Storage → Blob store → .env.local tab (auto-set on Vercel deploys)
# ---------------------------------------------------------------------------
# [required]
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx
# [required] The store's public host: the host of any file URL in the store.
# It's the token's store id (the part after "vercel_blob_rw_"), lowercased,
# plus ".public.blob.vercel-storage.com". The CSP allows only this store.
BLOB_PUBLIC_HOST=xxxxxxxxxxxxxxxx.public.blob.vercel-storage.com

# ---------------------------------------------------------------------------
# Trigger.dev (background jobs)
# cloud.trigger.dev → Project → API Keys  (use the DEV key locally, PROD key on Vercel)
# ---------------------------------------------------------------------------
# [required]
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxxxxxxxxxx
# [optional] cloud.trigger.dev → Project settings (read by trigger.config.ts)
TRIGGER_PROJECT_REF=proj_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# AI — OpenRouter (chat, structured output, Whisper, TTS, embeddings) [trigger]
# openrouter.ai → Keys. University-paid; set a spend limit on the key itself.
# ---------------------------------------------------------------------------
# [required]
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Course assistant tuning (optional; defaults live in code)
# ---------------------------------------------------------------------------
# [optional] Minimum vector similarity for a question to count as on-syllabus.
# Below this (and no full-text hit) the assistant refuses without an LLM call.
# Picked with `npm run eval:retrieval` (on the test lecture: on-syllabus >= 0.33,
# off-syllabus <= 0.17). Re-run it once the real demo lecture is loaded.
ASSISTANT_MIN_SIMILARITY=0.25

# ---------------------------------------------------------------------------
# Daily AI limit per person (feature 25; optional, defaults live in code)
# A safety limit, not credits: over the last 24 hours, a person may make this
# many AI calls and spend this much (USD). Free models log $0 but share the
# key's quota, so calls count too. Checked before an assistant or space-chat
# question, a new private note or retry, a podcast and a regenerate.
# Instructors and admins use the STAFF values.
# ---------------------------------------------------------------------------
# [optional] Default 150 calls and $0.25 a day for students.
AI_DAILY_CALLS_STUDENT=150
AI_DAILY_USD_STUDENT=0.25
# [optional] Default 1000 calls and $3 a day for staff.
AI_DAILY_CALLS_STAFF=1000
AI_DAILY_USD_STAFF=3

# ---------------------------------------------------------------------------
# Documents (feature 18)
# ---------------------------------------------------------------------------
# [optional] Longest recording or YouTube video accepted as a document or
# private note, in minutes (default 90). Checked before transcribing. [trigger]
DOCUMENT_MAX_MINUTES=90

# ---------------------------------------------------------------------------
# Video processing (feature 10)
# ---------------------------------------------------------------------------
# [optional] Longest lecture accepted, in minutes (default 60).     [trigger]
VIDEO_MAX_MINUTES=60
# [optional] Local ffmpeg for `trigger dev` only — point at the ffmpeg-static /
# ffprobe-static dev dependencies (Windows paths shown). Deployed tasks get
# these from the ffmpeg() build extension; don't set them in the dashboard.
FFMPEG_PATH=C:/path/to/lms/node_modules/ffmpeg-static/ffmpeg.exe
FFPROBE_PATH=C:/path/to/lms/node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe
