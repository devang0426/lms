# Studyhall — environment variables
# Copy to .env.local for local dev. Never commit real values.
# Variables marked [trigger] must ALSO be set in the Trigger.dev dashboard
# (Project → Environment Variables), because tasks run on Trigger.dev's machines.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shows the one-click demo account picker on the sign-in page. Never "true" in a real rollout.
DEMO_MODE=true
# Password set on both demo accounts by `npm run db:seed` (demo admin + demo student).
DEMO_ACCOUNT_PASSWORD=change-me-demo-2026

# ---------------------------------------------------------------------------
# Neon Postgres (+ pgvector)                                         [trigger]
# neon.tech → Project → Connection Details
# ---------------------------------------------------------------------------
# Direct connection (no "-pooler" in the host): used by drizzle-kit migrations.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/studyhall?sslmode=require
# Pooled connection (host contains "-pooler"): used by the app and tasks.
DATABASE_URL_POOLED=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/studyhall?sslmode=require

# ---------------------------------------------------------------------------
# Clerk (auth)
# dashboard.clerk.com → API Keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_replace-with-your-clerk-secret-key
# dashboard.clerk.com → Webhooks → endpoint for /api/webhooks/clerk (user.created, user.updated, user.deleted)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Sign-in/up URLs and redirects are set in code (proxy.ts, app/layout.tsx); no env needed.

# ---------------------------------------------------------------------------
# Vercel Blob (videos, documents, captions, podcasts, submissions)   [trigger]
# Vercel → Storage → Blob store → .env.local tab (auto-set on Vercel deploys)
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Trigger.dev (background jobs)
# cloud.trigger.dev → Project → API Keys  (use the DEV key locally, PROD key on Vercel)
# ---------------------------------------------------------------------------
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxxxxxxxxxx
# cloud.trigger.dev → Project settings (read by trigger.config.ts)
TRIGGER_PROJECT_REF=proj_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# AI — OpenRouter (chat, structured output, Whisper, TTS, embeddings) [trigger]
# openrouter.ai → Keys. University-paid; set a spend limit on the key itself.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Course assistant tuning (optional; defaults live in code)
# ---------------------------------------------------------------------------
# Minimum vector similarity for a question to count as on-syllabus.
# Below this (and no full-text hit) the assistant refuses without an LLM call.
# Picked with `npm run eval:retrieval` (on the test lecture: on-syllabus >= 0.33,
# off-syllabus <= 0.17). Re-run it once the real demo lecture is loaded.
ASSISTANT_MIN_SIMILARITY=0.25

# ---------------------------------------------------------------------------
# Video processing (feature 10)
# ---------------------------------------------------------------------------
# Longest lecture accepted, in minutes (default 60).                [trigger]
VIDEO_MAX_MINUTES=60
# Local ffmpeg for `trigger dev` only — point at the ffmpeg-static /
# ffprobe-static dev dependencies (Windows paths shown). Deployed tasks get
# these from the ffmpeg() build extension; don't set them in the dashboard.
FFMPEG_PATH=C:/path/to/lms/node_modules/ffmpeg-static/ffmpeg.exe
FFPROBE_PATH=C:/path/to/lms/node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe
